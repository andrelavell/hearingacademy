---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import topics from '../../data/topics_index.json';
import categories from '../../data/categories.json';

export async function getStaticPaths() {
  const slugify = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');
  const cats = Array.isArray(categories) ? categories : [];
  return cats.map((c) => ({ params: { slug: slugify(c) } }));
}

const { slug } = Astro.params;
const slugify = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');
const parseDate = (d) => Date.parse(d || 0) || 0;
const category = (Array.isArray(categories) ? categories : []).find((c) => slugify(c) === slug);
const items = (Array.isArray(topics) ? topics : [])
  .filter((it) => category ? it.category === category : false)
  .slice()
  .sort((a,b) => (parseDate(b.publishedTime || b.modifiedTime) - parseDate(a.publishedTime || a.modifiedTime)));
const pageTitle = category ? `Category: ${category}` : 'Category';
const FALLBACK_IMG = '/images/articles/2025-08/ai-hearing-aids-noise-pexels-14682242.jpg';

// Load reviews and filter by category tag
const reviewModules = import.meta.glob('../reviews/*.md', { eager: true }) as Record<string, any>;
const allReviews = Object.entries(reviewModules).map(([p, mod]) => {
  const fm = (mod as any)?.frontmatter || {};
  const slug = p.replace('../reviews/', '').replace(/\.md$/, '');
  const tags = Array.isArray(fm.tags) ? fm.tags : [];
  const img = (fm.image && fm.image !== '/article-default.jpg') ? fm.image : (fm.productImage || FALLBACK_IMG);
  return {
    slug,
    title: fm.title || slug,
    image: img || FALLBACK_IMG,
    publishedTime: fm.publishedTime || '',
    _date: parseDate(fm.publishedTime || fm.modifiedTime),
    tags,
  };
}).sort((a,b) => b._date - a._date);
const relatedReviews = category
  ? allReviews.filter(r => (r.tags || []).some(t => slugify(t) === slugify(category)))
  : [];
const latestRelatedReviews = relatedReviews.slice(0, 3);
---

<BaseLayout title={pageTitle} description={category ? `Articles in ${category}` : 'Category articles'}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <h1>{pageTitle}</h1>
        {!category && <p>Category not found.</p>}
      </div>
    </section>

    {category && (
      <section class="listing">
        <div class="container">
          {items.length === 0 ? (
            <p>No articles found in this category yet.</p>
          ) : (
            <div class="articles-grid">
              {items.map(item => (
                <article class="article-card">
                  <div class="article-image">
                    <img src={(item.image && item.image !== '/article-default.jpg') ? item.image : FALLBACK_IMG} alt={item.title} width="400" height="250" />
                  </div>
                  <div class="article-content">
                    <div class="article-meta">
                      <span class="category">{item.category}</span>
                      {item.publishedTime && (
                        <time datetime={item.publishedTime}>{new Date(item.publishedTime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                      )}
                    </div>
                    <h3><a href={`/articles/${item.slug}`}>{item.title}</a></h3>
                    {item.description && <p>{item.description}</p>}
                    <a href={`/articles/${item.slug}`} class="read-more">Read More</a>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    {category && latestRelatedReviews.length > 0 && (
      <section class="reviews-section">
        <div class="container">
          <div class="section-header">
            <h2>Latest Reviews in {category}</h2>
            <a href="/reviews" class="view-all">View All Reviews</a>
          </div>
          <div class="reviews-grid">
            {latestRelatedReviews.map(r => (
              <article class="review-card">
                <div class="review-image">
                  <img src={r.image || FALLBACK_IMG} alt={r.title} width="400" height="250" />
                </div>
                <div class="review-content">
                  {r.publishedTime && (
                    <div class="review-meta">
                      <span class="badge">Review</span>
                      <time datetime={r.publishedTime}>{new Date(r.publishedTime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                    </div>
                  )}
                  <h3><a href={`/reviews/${r.slug}`}>{r.title}</a></h3>
                  <a href={`/reviews/${r.slug}`} class="read-more">Read Review</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero { padding: var(--space-8) 0 var(--space-6); background: var(--color-background-light); }
  .listing { padding: var(--space-6) 0 var(--space-8); }
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); }
  .article-card { background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
  .article-image img { width: 100%; height: 200px; object-fit: cover; }
  .article-content { padding: var(--space-4); }
  .article-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); font-size: var(--fs-200); }
  .category { background: var(--color-primary); color: white; padding: var(--space-1) var(--space-3); border-radius: 20px; font-weight: var(--fw-medium); }
  .read-more { color: var(--color-primary); font-weight: var(--fw-semibold); text-decoration: none; font-size: var(--fs-200); }

  /* Reviews section */
  .reviews-section { padding: var(--space-6) 0 var(--space-8); background: white; }
  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6); }
  .view-all { color: var(--color-primary); font-weight: var(--fw-semibold); text-decoration: none; }
  .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); }
  .review-card { background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
  .review-image img { width: 100%; height: 200px; object-fit: cover; }
  .review-content { padding: var(--space-4); }
  .review-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); font-size: var(--fs-200); color: var(--color-text-muted); }
  .badge { background: var(--color-secondary); color: #fff; padding: 2px 10px; border-radius: 999px; font-size: var(--fs-100); }
</style>
