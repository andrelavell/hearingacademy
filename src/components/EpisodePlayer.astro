---
export interface Props {
  title: string;
  audio: string; // URL or /episodes/audio/... path
  captions?: string; // optional /episodes/captions/... .vtt
  rating?: number;
  views?: number;
  slug?: string;
}

const { title, audio, captions = '', rating = 0, views = 0, slug = '' } = Astro.props;
const mime = String(audio || '').toLowerCase().endsWith('.wav') ? 'audio/wav' : 'audio/mpeg';

const stars = Array.from({ length: 5 }, (_, i) => i < Math.round(Math.max(0, Math.min(5, rating))) );
---

<section class="player-wrap" data-slug={slug}>
  <div class="player-card">
    <div class="player-meta">
      <h1 class="title">{title}</h1>
      <div class="meta">
        <div class="stars" aria-label={`Rating: ${rating} out of 5`}>
          {stars.map((on, i) => (
            <svg class={on ? 'star on' : 'star'} width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .587l3.668 7.431L24 9.748l-6 5.853L19.335 24 12 19.897 4.665 24 6 15.601 0 9.748l8.332-1.73z"/></svg>
          ))}
          <span class="rating-text">{rating.toFixed(1)}</span>
        </div>
        <div class="views" aria-label={`${views} plays`}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 12a5 5 0 110-10 5 5 0 010 10z"/></svg>
          <span>{views.toLocaleString()} listens</span>
        </div>
      </div>
    </div>

    <div class="controls" id="controls">
      <button class="btn skip" data-action="back" aria-label="Back 15 seconds">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 6V2L4 9l7 7v-4c3.31 0 6 2.69 6 6 0 .34-.03.67-.08 1 1.79-1.34 2.96-3.45 3.06-5.84C20.11 9.46 15.97 6 11 6z"/></svg>
        <span>15</span>
      </button>

      <button class="btn play" data-action="toggle" aria-label="Play">
        <svg class="icon-play" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        <svg class="icon-pause" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <button class="btn skip" data-action="forward" aria-label="Forward 30 seconds">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 6V2l7 7-7 7v-4c-3.31 0-6 2.69-6 6 0 .34.03.67.08 1-1.79-1.34-2.96-3.45-3.06-5.84C3.89 9.46 8.03 6 13 6z"/></svg>
        <span>30</span>
      </button>
    </div>

    <div class="timeline">
      <span class="time" id="currentTime">0:00</span>
      <input type="range" min="0" value="0" step="0.01" id="seek" aria-label="Seek" />
      <span class="time" id="duration">0:00</span>
    </div>

    <div class="bottom-bar">
      <button class="rate" id="rate" aria-label="Playback speed">1.0×</button>
      <div class="captions-toggle">
        {captions && <button class="cap-btn" id="capToggle" aria-label="Toggle captions">CC</button>}
      </div>
    </div>

    <div class="caption-bar" id="captionBar" aria-live="polite" aria-atomic="true"></div>

    <audio id="audio" preload="metadata">
      <source src={audio} type={mime} />
      {captions && <track id="track" kind="subtitles" srcLang="en" src={captions} default />}
    </audio>
  </div>
</section>

<style>
  .player-wrap { padding: var(--space-7) var(--gutter); background: var(--color-background-light); }
  .player-card { max-width: 900px; margin: 0 auto; background: white; border: 1px solid var(--color-border); border-radius: 16px; padding: var(--space-6); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
  .player-meta { margin-bottom: var(--space-5); }
  .title { font-family: var(--font-family-serif); font-size: var(--fs-700); margin: 0 0 var(--space-2); }
  .meta { display: flex; gap: var(--space-4); align-items: center; color: var(--color-text-muted); }
  .stars { display: inline-flex; align-items: center; gap: 6px; }
  .star { fill: #e5e7eb; }
  .star.on { fill: #f59e0b; }
  .rating-text { margin-left: 4px; font-weight: var(--fw-medium); color: var(--color-text); }
  .views { display: inline-flex; align-items: center; gap: 6px; }

  .controls { display:flex; align-items:center; justify-content:center; gap: var(--space-6); margin: var(--space-4) 0; }
  .btn { border: none; background: #0f172a; color: white; border-radius: 50%; width: 64px; height: 64px; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow: 0 10px 20px rgba(15,23,42,0.15); transition: transform .1s ease, box-shadow .2s ease; }
  .btn:hover { transform: translateY(-1px); box-shadow: 0 14px 24px rgba(15,23,42,0.2); }
  .btn.skip { background: #111827; width: 56px; height: 56px; position: relative; }
  .btn.skip span { position:absolute; bottom:6px; font-size: 12px; opacity:.9; }
  .btn.play { width: 80px; height: 80px; background: var(--color-primary); }
  .btn.play .icon-pause { display: none; }
  .btn.play.playing .icon-play { display: none; }
  .btn.play.playing .icon-pause { display: block; }

  .timeline { display:flex; align-items:center; gap: var(--space-3); }
  #seek { flex:1; appearance:none; height: 6px; border-radius: 999px; background: linear-gradient(90deg, var(--color-primary) var(--progress,0%), #e5e7eb 0%); outline:none; }
  #seek::-webkit-slider-thumb { appearance:none; width:16px; height:16px; border-radius:50%; background:white; border:2px solid var(--color-primary); box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
  .time { font-size: var(--fs-200); color: var(--color-text-muted); min-width: 48px; text-align:center; }

  .bottom-bar { display:flex; justify-content: space-between; align-items:center; margin-top: var(--space-3); }
  .rate { background: #f3f4f6; color:#111827; border:none; padding: 6px 10px; border-radius: 8px; cursor:pointer; }
  .cap-btn { background: #f3f4f6; border:none; padding: 6px 10px; border-radius: 8px; cursor:pointer; }

  .caption-bar { margin-top: var(--space-5); padding: var(--space-4); background: #0f172a; color: #e5e7eb; border-radius: 12px; font-size: var(--fs-400); line-height: var(--lh-snug); min-height: 64px; }

  @media (max-width: 600px) {
    .controls { gap: var(--space-3); }
    .btn.play { width: 68px; height: 68px; }
    .btn.skip { width: 48px; height: 48px; }
  }
</style>

<script>
  (function(){
    const $ = (s) => document.querySelector(s);
    const audio = $('#audio');
    const seek = $('#seek');
    const btnPlay = document.querySelector('.btn.play');
    const btnBack = document.querySelector('.btn.skip[data-action="back"]');
    const btnFwd = document.querySelector('.btn.skip[data-action="forward"]');
    const tCur = $('#currentTime');
    const tDur = $('#duration');
    const rate = $('#rate');
    const captionBar = $('#captionBar');
    const capToggle = $('#capToggle');
    const fmt = (sec) => {
      sec = Math.max(0, sec||0);
      const m = Math.floor(sec/60);
      const s = Math.floor(sec%60);
      return `${m}:${String(s).padStart(2,'0')}`;
    };

    let cues = [];
    let captionsOn = true;

    function updateSeekBg() {
      const val = (Number(seek.value) || 0);
      const max = Number(seek.max) || 1;
      const pct = Math.min(100, Math.max(0, (val / max) * 100));
      seek.style.setProperty('--progress', pct + '%');
    }

    function updateCaption(currentTime) {
      if (!captionsOn || !cues.length) return;
      let i = cues.findIndex(c => currentTime < c.end - 0.05);
      if (i === -1) i = cues.length - 1;
      for (let j = 0; j < cues.length; j++) {
        const c = cues[j];
        if (currentTime >= c.start && currentTime <= c.end) {
          captionBar.textContent = c.text;
          return;
        }
      }
    }

    audio.addEventListener('loadedmetadata', () => {
      seek.max = audio.duration || 0;
      tDur.textContent = fmt(audio.duration);
      updateSeekBg();
    });

    audio.addEventListener('timeupdate', () => {
      seek.value = audio.currentTime || 0;
      tCur.textContent = fmt(audio.currentTime);
      updateSeekBg();
      updateCaption(audio.currentTime);
    });

    async function incViewsOnce() {
      try {
        const root = document.querySelector('.player-wrap');
        const slug = root?.dataset?.slug || '';
        if (!slug) return;
        const key = 'episode_viewed_' + slug;
        if (localStorage.getItem(key)) return;
        localStorage.setItem(key, '1');
        await fetch('/.netlify/functions/episodes', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ op: 'inc', field: 'views', slug, by: 1 })
        });
      } catch {}
    }

    btnPlay.addEventListener('click', () => {
      if (audio.paused) { audio.play(); btnPlay.classList.add('playing'); }
      else { audio.pause(); btnPlay.classList.remove('playing'); }
    });

    audio.addEventListener('play', incViewsOnce, { once: true });

    btnBack.addEventListener('click', () => { audio.currentTime = Math.max(0, (audio.currentTime||0) - 15); });
    btnFwd.addEventListener('click', () => { audio.currentTime = Math.min(audio.duration||0, (audio.currentTime||0) + 30); });

    seek.addEventListener('input', () => {
      audio.currentTime = Number(seek.value) || 0;
      updateSeekBg();
    });

    const rates = [0.8, 1.0, 1.25, 1.5, 1.75, 2.0];
    let ri = 1;
    rate.addEventListener('click', () => {
      ri = (ri + 1) % rates.length;
      audio.playbackRate = rates[ri];
      rate.textContent = rates[ri].toFixed(2).replace(/\.00$/, '') + '×';
    });

    if (capToggle) {
      capToggle.addEventListener('click', () => {
        captionsOn = !captionsOn;
        captionBar.style.display = captionsOn ? 'block' : 'none';
      });
    }

    // Load cues from text track if present for custom rendering
    const track = document.getElementById('track');
    function collectCues() {
      try {
        const tt = audio.textTracks && audio.textTracks[0];
        if (!tt) return;
        tt.mode = 'hidden';
        cues = Array.from(tt.cues || []).map(c => ({ start: c.startTime, end: c.endTime, text: c.text }));
      } catch {}
    }
    if (track) {
      collectCues();
      track.addEventListener('load', collectCues);
    }
  })();
</script>
