---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import episodes from '../../data/episodes.json';

const title = 'Episodes';
const description = 'Listen to our academic-style audio episodes on hearing health and technology. Transcripts and captions included.';
---

<BaseLayout title={title} description={description} image="/images/articles/2025-08/ai-hearing-aids-noise-pexels-14682242.jpg">
  <Header />

  <main class="page">
    <section class="hero">
      <div class="container">
        <h1>Episodes</h1>
        <p class="lead">Thoughtful, research-forward listening. Explore episodes with clean captions and a premium player experience.</p>
      </div>
    </section>

    <section class="list">
      <div class="container grid">
        {Array.isArray(episodes) && episodes.length ? episodes.map((e) => (
          <article class="card">
            <div class="card-body">
              <h2 class="card-title"><a href={`/episodes/${e.slug}`}>{e.title}</a></h2>
              <p class="excerpt">{(e.body || '').slice(0, 180)}{(e.body || '').length > 180 ? '…' : ''}</p>
              <div class="meta">
                <span class="rating" aria-label={`Rating ${e.rating}/5`}>
                  {'★'.repeat(Math.round(e.rating||0))}{'☆'.repeat(5 - Math.round(e.rating||0))}
                  <span class="num">{Number(e.rating||0).toFixed(1)}</span>
                </span>
                <span class="views">{(e.views||0).toLocaleString()} listens</span>
              </div>
              <a class="btn" href={`/episodes/${e.slug}`}>Listen</a>
            </div>
          </article>
        )) : (
          <div class="empty">No episodes yet. Visit <a href="/episodes/admin">Episodes Admin</a> to add one.</div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero { padding: var(--space-7) 0 var(--space-5); background: var(--color-background-light); }
  .lead { color: var(--color-text-muted); max-width: 800px; }
  .list { padding: var(--space-7) 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); }
  .card { background: white; border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; box-shadow: 0 6px 16px rgba(0,0,0,0.05); }
  .card-body { padding: var(--space-5); display:flex; flex-direction:column; gap: var(--space-4); }
  .card-title { font-size: var(--fs-500); margin: 0; }
  .excerpt { color: var(--color-text-muted); }
  .meta { display:flex; gap: var(--space-4); align-items:center; color: var(--color-text-muted); }
  .rating { display:inline-flex; gap: 6px; align-items:center; color: #f59e0b; }
  .rating .num { color: var(--color-text); font-weight: var(--fw-medium); margin-left: 2px; }
  .btn { display:inline-block; text-decoration:none; background: var(--color-primary); color:white; padding: 10px 14px; border-radius: 10px; font-weight: var(--fw-medium); }
  .btn:hover { background: var(--color-primary-light); }
  .empty { color: var(--color-text-muted); }
</style>
